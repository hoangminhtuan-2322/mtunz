{
  "expo": {
    "name": "mtunz",
    "slug": "mtunz-mobile",
    "scheme": "mtunz",
    "version": "1.1.1",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "android": {
      "package": "com.mtunz.web",
      "versionCode": 4,
      "permissions": [
        "POST_NOTIFICATIONS"
      ],
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#121b36"
      }
    },
    "ios": {
      "bundleIdentifier": "com.mtunz.mobile",
      "supportsTablet": true,
      "icon": "./assets/icon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Cho phép mtunz chọn ảnh và video để gửi tin nhắn.",
          "cameraPermission": "Cho phép mtunz sử dụng máy ảnh khi bạn yêu cầu."
        }
      ],
      "expo-notifications",
      [
        "expo-audio",
        {
          "microphonePermission": "Cho phép mtunz ghi tin nhắn thoại khi bạn yêu cầu.",
          "enableBackgroundRecording": false
        }
      ]
    ],
    "icon": "./assets/icon.png"
  }
}
