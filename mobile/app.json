{
  "expo": {
    "name": "mtunz",
    "slug": "mtunz-mobile",
    "scheme": "mtunz",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "android": {
      "package": "com.mtunz.mobile",
      "permissions": [
        "POST_NOTIFICATIONS"
      ],
      "softwareKeyboardLayoutMode": "resize"
    },
    "ios": {
      "bundleIdentifier": "com.mtunz.mobile",
      "supportsTablet": true
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Cho phép mtunz chọn ảnh và video để gửi tin nhắn.",
          "cameraPermission": "Cho phép mtunz sử dụng máy ảnh khi bạn yêu cầu."
        }
      ],
      "expo-notifications",
      [
        "expo-audio",
        {
          "microphonePermission": "Cho phép mtunz ghi tin nhắn thoại khi bạn yêu cầu.",
          "enableBackgroundRecording": false
        }
      ]
    ]
  }
}
